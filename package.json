{
  "name": "3d-shirt-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "build": "node -e \"import('node:fs').then(fs => fs.existsSync('index.html') ? import('node:child_process').then(cp => cp.spawnSync('npx', ['vite', 'build'], {stdio: 'inherit', shell: true})) : console.log('✅ Backend API listo'))\"",
    "build:client": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "vite": "^5.0.12"
  }
}
